# Copy this file to .env and fill in values. .env is gitignored.

# MongoDB connection. Defaults shown work with the local Docker container:
#   docker run -d --name pokemon-etb-mongo -p 27017:27017 -v mongo-data:/data/db mongo:7
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pokemon_etb

# TCGplayer Marketplace API app key. Optional — until both are set, the
# tcgplayer source is skipped cleanly and the rest of the pipeline runs
# normally. Request a key at https://docs.tcgplayer.com/docs/getting-started
TCGPLAYER_CLIENT_ID=
TCGPLAYER_CLIENT_SECRET=

# PriceCharting, Bulbapedia, 130point, PSA pop, and Google Trends need no
# API keys: PriceCharting/Bulbapedia are scraped respectfully (see README),
# 130point/PSA pop are manual-CSV-driven (see manual_data/), and Google
# Trends uses pytrends with no key required.
